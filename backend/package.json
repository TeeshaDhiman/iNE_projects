{
  "name": "price-tracker-backend",
  "version": "1.0.0",
  "description": "Backend for Product Price Tracker",
  "main": "dist/index.js",
  "scripts": {
    "start": "node dist/index.js",
    "build": "tsc",
    "dev": "ts-node-dev --respawn --transpile-only src/index.ts",
    "scrape:headed": "cross-env HEADED=true ts-node src/scripts/runHeaded.ts",
    "scrape:headless": "cross-env HEADED=false ts-node src/scripts/runHeaded.ts",
    "prisma:generate": "prisma generate",
    "prisma:push": "prisma db push"
  },
  "dependencies": {
    "@prisma/client": "^5.0.0",
    "@sendgrid/mail": "^8.1.6",
    "@supabase/supabase-js": "^2.109.0",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "node-cron": "^4.6.0",
    "playwright": "^1.40.0",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@types/cors": "^2.8.13",
    "@types/express": "^4.17.17",
    "@types/node": "^20.5.1",
    "@types/node-cron": "^3.0.11",
    "@types/ws": "^8.18.1",
    "cross-env": "^7.0.3",
    "prisma": "^5.0.0",
    "ts-node": "^10.9.1",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.1.6"
  }
}
